        "src": "actor TokenStore {\n  private var refreshTask: Task<Token, Error>?\n\n  func validToken() async throws -> Token {\n    if let task = refreshTask {\n      return try await task.value\n    }\n    let task = Task { try await refresh() }\n    refreshTask = task\n    defer { refreshTask = nil }\n    return try await task.value\n  }\n}"
